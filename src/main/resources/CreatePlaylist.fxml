<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="view.CreatePlaylistController"
        stylesheets="@style.css"
        prefWidth="700.0"
        prefHeight="650.0">

   <children>

      <VBox
              alignment="TOP_CENTER"
              spacing="18.0"
              AnchorPane.topAnchor="35.0"
              AnchorPane.bottomAnchor="35.0"
              AnchorPane.leftAnchor="120.0"
              AnchorPane.rightAnchor="120.0">

         <padding>
            <Insets top="20.0"
                    right="30.0"
                    bottom="20.0"
                    left="30.0"/>
         </padding>

         <children>

            <Label
                    alignment="CENTER"
                    text="Create Playlist"
                    styleClass="title-label"/>

            <TextField
                    fx:id="playlistNameField"
                    promptText="Enter playlist name"
                    maxWidth="420.0"
                    prefHeight="42.0"/>

            <Label
                    text="Available Songs"
                    styleClass="section-title"/>

            <Button
                    text="+ Import Song"
                    onAction="#importSong"
                    prefWidth="180.0"
                    prefHeight="42.0"
                    styleClass="import-song-button"/>

            <ListView
                    fx:id="songListView"
                    prefHeight="230.0"
                    maxWidth="420.0"
                    styleClass="queue-list"/>

            <Label
                    text="Cover Image (Optional)"
                    styleClass="section-title"/>

            <Button
                    fx:id="chooseImageButton"
                    mnemonicParsing="false"
                    onAction="#chooseImage"
                    text="Upload"
                    styleClass="small-button"/>

            <Label
                    fx:id="selectedImageLabel"
                    text="No Image Selected"
                    styleClass="queue-label"/>

            <HBox
                    alignment="CENTER"
                    spacing="18.0">

               <children>

                  <Button
                          fx:id="createButton"
                          mnemonicParsing="false"
                          onAction="#createPlaylist"
                          text="Create"
                          styleClass="small-button"/>

                  <Button
                          fx:id="cancelButton"
                          mnemonicParsing="false"
                          text="Cancel"
                          styleClass="small-button"/>

               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</AnchorPane>
