<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox stylesheets="@style.css"
      alignment="CENTER"
      prefHeight="650.0"
      prefWidth="400.0"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.songs.MusicPlayerController">


    <padding>
        <Insets bottom="30.0"
                left="30.0"
                right="30.0"
                top="30.0" />
    </padding>


    <Label text="Tune Teller"
           styleClass="title-label">

        <font>
            <Font name="System Bold" size="24.0"/>
        </font>

    </Label>



    <ImageView fitHeight="220.0"
               fitWidth="220.0"
               pickOnBounds="true"
               preserveRatio="true"/>



    <Label fx:id="songLabel"
           text="No song loaded"
           styleClass="song-label">

        <font>
            <Font name="System Bold Italic" size="22.0"/>
        </font>

    </Label>



    <Label fx:id="artistLabel"
           text="Add Artist"
           styleClass="artist-label">

        <font>
            <Font name="System Bold" size="15.0"/>
        </font>

    </Label>



    <!-- AUDIO VISUALIZER -->
    <Canvas fx:id="visualizerCanvas"
            width="320"
            height="100"/>



    <Label fx:id="nextSongLabel"
           text="Up Next: None"
           styleClass="queue-label">

        <font>
            <Font name="System Bold" size="14.0"/>
        </font>

    </Label>



    <Slider fx:id="progressSlider"
            maxWidth="300.0"
            prefWidth="300.0"/>



    <HBox alignment="CENTER"
          spacing="200">


        <Label fx:id="currentTimeLabel"
               text="0:00"
               styleClass="time-label">

            <font>
                <Font name="System Bold" size="14.0"/>
            </font>

        </Label>



        <Label fx:id="totalTimeLabel"
               text="0:00"
               styleClass="time-label">

            <font>
                <Font name="System Bold" size="14.0"/>
            </font>

        </Label>


    </HBox>



    <HBox alignment="CENTER"
          spacing="15.0">


        <Button onAction="#previousSong"
                text="⏮"/>


        <Button onAction="#playSong"
                text="▶"/>


        <Button onAction="#pauseSong"
                text="⏸"/>


        <Button onAction="#stopSong"
                text="■"/>


        <Button onAction="#nextSong"
                text="⏭"/>


    </HBox>


</VBox>