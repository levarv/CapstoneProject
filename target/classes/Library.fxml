<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.LibraryController"
            stylesheets="@style.css"
            styleClass="library-root"
            prefWidth="1200"
            prefHeight="750">

    <left>
        <VBox prefWidth="260"
              minWidth="260"
              spacing="18"
              alignment="TOP_CENTER"
              styleClass="library-sidebar">

            <Label text="NIGHT MUSIC"
                   styleClass="sidebar-logo"/>

            <Button text="Home"
                    onAction="#goHome"
                    styleClass="sidebar-button"/>

            <Button text="Library"
                    styleClass="sidebar-button-active"/>

            <Button text="Playlists"
                    onAction="#goPlaylist"
                    styleClass="sidebar-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="24"
              alignment="TOP_CENTER"
              styleClass="library-content">

            <Label text="Your Music Library"
                   styleClass="library-title"/>

            <TextField promptText="Search songs..."
                       maxWidth="520"
                       prefHeight="48"
                       styleClass="library-search"/>



            <ListView fx:id="libraryList"
                      maxWidth="850"
                      prefHeight="560"
                      styleClass="library-list"/>
        </VBox>
    </center>

</BorderPane>